# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Video files (too large for GitHub)
*.mp4
*.avi
*.mov
*.mkv
*.zip
*.tar.gz

# Data & Evidence artifacts
data/*.sqlite
data/*.sqlite-journal
data/*.db
evidence/plates/*
!evidence/plates/.gitkeep
evidence/vehicles/*
!evidence/vehicles/.gitkeep
reports/*.xlsx
!reports/.gitkeep

# Model weights (auto-downloaded by ultralytics)
*.pt
*.onnx
!yolov8n.onnx
!yolo26n.onnx

# Temporary / OS / local files
.DS_Store
Thumbs.db
gitingest-ingest/
benchmarks/ground_truth_candidates/
benchmarks/experiments/
benchmarks/*.jpg
trt_cache/
.coverage
.pytest_cache/
